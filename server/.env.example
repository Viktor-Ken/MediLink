PORT=4000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=hospital
JWT_SECRET=change-me-in-production

# --- License / lease (optional) ---
# The trust anchor is EMBEDDED in src/license.js; deleting files cannot disable it.
# The token (exp.kid.machineFp.signature) lives in server/license.txt (shipped)
# or can be overridden here. First run binds to the machine; a copied folder or
# a rolled-back clock locks (fail-closed).
#LICENSE_TOKEN=2027-01-31.k1..MEQCI...   (empty machineFp = portable, binds on first run)
# Optional test-only override of the anti-rollback state file:
#LICENSE_STATE_FILE=C:\temp\.license_state

# --- Login rate limiting (per IP, per 60s window) ---
#AUTH_RATE_LIMIT=30

# --- AI assistant (optional) ---
# The API key stays on the server and is never sent to the browser.
# Chat is disabled (503) until OPENAI_API_KEY is set.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#CHAT_MODEL=gpt-4o-mini
#CHAT_RATE_LIMIT=20
#CHAT_SYSTEM_PROMPT=

# --- Single sign-on with Clerk (optional) ---
# When set, staff can sign in via Clerk; MediLink still issues its own JWT and
# RBAC is unchanged. The publishable key is a browser value that goes in
# web/.env (VITE_CLERK_PUBLISHABLE_KEY); the secret key stays here only.
# CLERK_ISSUER is your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#CLERK_SECRET_KEY=
#CLERK_ISSUER=
#CLERK_JWKS_URL=
#CLERK_AUTHORIZED_PARTIES=
#CSP_* — the CSP is expanded automatically when Clerk is configured.