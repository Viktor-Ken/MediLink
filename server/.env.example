PORT=4000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=hospital

# --- Managed Postgres (Supabase, RDS, etc.) ---
# Set DATABASE_URL to use a single connection string instead of the discrete
# PG* vars above (Supabase: Project Settings -> Database -> Connection string).
# Prefer the "Connection pooling" URI (port 6543) over the direct one (5432)
# for a server that opens many short-lived connections, like this one.
#DATABASE_URL=postgres://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
# Managed providers require TLS. Without this, connecting fails outright.
#   require      - encrypt, don't verify the server cert (Supabase's own
#                  recommended node-postgres setting; fine for most setups)
#   verify-full  - encrypt and verify against PGSSLROOTCERT (download the
#                  provider's CA cert, e.g. Supabase's prod-ca-2021.crt)
#PGSSLMODE=require
#PGSSLROOTCERT=/path/to/prod-ca-2021.crt

# Required in production: a random value of at least 32 characters.
JWT_SECRET=change-me-in-production
NODE_ENV=development
# Set to the number of reverse proxies in front of the API (e.g. 1 behind nginx /
# a platform load balancer). Without it every client shares the proxy's IP and
# the login rate limiter treats all users as one.
#TRUST_PROXY=1
# Production first-run admin (db:migrate). If unset, a random password is printed once.
#SEED_ADMIN_PASSWORD=
# Load the demo patients/staff (publicly known passwords) — never in production.
#SEED_DEMO=1

# --- License / lease (optional) ---
# The trust anchor is EMBEDDED in src/license.js; deleting files cannot disable it.
# The token (exp.kid.machineFp.signature) lives in server/license.txt (shipped)
# or can be overridden here. First run binds to the machine; a copied folder or
# a rolled-back clock locks (fail-closed).
#LICENSE_TOKEN=2027-01-31.k1..MEQCI...   (empty machineFp = portable, binds on first run)
# Optional test-only override of the anti-rollback state file:
#LICENSE_STATE_FILE=C:\temp\.license_state

# --- Login rate limiting (per IP, per 60s window) ---
# The attempt buckets are bounded LRU maps, so a flood of unique keys cannot
# grow memory without limit.
#AUTH_RATE_LIMIT=30
#RATE_LIMIT_KEYS=10000

# --- In-process LRU response caches (departments, staff, ward board) ---
# Reference reads are cached per worker with a short TTL; writes invalidate the
# caches handled by this worker and the TTL bounds staleness across workers.
# Set CACHE_DISABLED=1 to bypass caching entirely (debugging stale reads).
#CACHE_DISABLED=0

# --- AI assistant (optional) ---
# The API key stays on the server and is never sent to the browser.
# One key powers two separate assistants: a staff one (any page once signed
# in) and a patient-portal one (/portal), each with its own system prompt —
# the patient one is never given real record data and always redirects
# medical/emergency questions to a person. Both are disabled (503) until
# OPENAI_API_KEY is set; there's nothing further to turn on for the portal one.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#CHAT_MODEL=gpt-4o-mini
#CHAT_RATE_LIMIT=20
# Overrides the staff assistant's system prompt only.
#CHAT_SYSTEM_PROMPT=
# Separate, lower default limit (per patient) for the portal assistant.
#PORTAL_CHAT_RATE_LIMIT=15
# Overrides the patient assistant's system prompt only — change this only if
# you understand why it avoids clinical advice and emergency handling by
# default; the defaults exist to keep a non-clinician-facing bot from acting
# like it can triage a patient.
#PORTAL_CHAT_SYSTEM_PROMPT=

# --- Single sign-on with Clerk (optional) ---
# When set, staff can sign in via Clerk; MediLink still issues its own JWT and
# RBAC is unchanged. The publishable key is a browser value that goes in
# web/.env (VITE_CLERK_PUBLISHABLE_KEY); the secret key stays here only.
# CLERK_ISSUER is your Clerk Frontend API URL, e.g. https://your-app.clerk.accounts.dev
#CLERK_SECRET_KEY=
#CLERK_ISSUER=
#CLERK_JWKS_URL=
#CLERK_AUTHORIZED_PARTIES=
#CSP_* — the CSP is expanded automatically when Clerk is configured.